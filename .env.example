APP_NAME="CFO"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=projects
DB_USERNAME=postgres
DB_PASSWORD=
DB_SSLMODE=prefer

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# BunnyCDN Edge Storage — public image uploads.
# Storage zone is shared with other projects, so this app writes under BUNNYCDN_PREFIX.
BUNNYCDN_STORAGE_ZONE=
BUNNYCDN_API_KEY=
BUNNYCDN_REGION=
BUNNYCDN_HOST=storage.bunnycdn.com
BUNNYCDN_PULL_ZONE_URL=
BUNNYCDN_TOKEN_AUTH_KEY=
BUNNYCDN_PREFIX=cfo

# Browser push notifications. Generate the pair with `php artisan webpush:vapid`.
# Leave blank to keep push switched off — the in-app notification centre works
# either way. Browsers only allow push over HTTPS.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Firebase Cloud Messaging — push for the seller app.
# A path to the service account JSON, the JSON itself, or a base64 copy of it.
FIREBASE_CREDENTIALS=
FIREBASE_PUSH_ENABLED=true
FIREBASE_ANDROID_CHANNEL=cfo_alerts

# Razorpay — taking money at checkout.
# Leave blank and non-COD orders are marked paid on placement, as before. Set
# them and the order waits for a real capture: the app opens an intent, the
# gateway answers, and the webhook settles it either way.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_CURRENCY=INR
