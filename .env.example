APP_NAME="CFO"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=projects
DB_USERNAME=postgres
DB_PASSWORD=
DB_SSLMODE=prefer

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379


AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# BunnyCDN Edge Storage — public image uploads.
# Storage zone is shared with other projects, so this app writes under BUNNYCDN_PREFIX.
BUNNYCDN_STORAGE_ZONE=
BUNNYCDN_API_KEY=
BUNNYCDN_REGION=
BUNNYCDN_HOST=storage.bunnycdn.com
BUNNYCDN_PULL_ZONE_URL=
BUNNYCDN_TOKEN_AUTH_KEY=
BUNNYCDN_PREFIX=cfo

# Browser push notifications. Generate the pair with `php artisan webpush:vapid`.
# Leave blank to keep push switched off — the in-app notification centre works
# either way. Browsers only allow push over HTTPS.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Firebase Cloud Messaging — push for the seller app.
# A path to the service account JSON, the JSON itself, or a base64 copy of it.
FIREBASE_CREDENTIALS=
FIREBASE_PUSH_ENABLED=true
FIREBASE_ANDROID_CHANNEL=cfo_alerts

# Razorpay — taking money at checkout.
# Leave blank and non-COD orders are marked paid on placement, as before. Set
# them and the order waits for a real capture: the app opens an intent, the
# gateway answers, and the webhook settles it either way.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_CURRENCY=INR

# Couriers are connected in the admin panel now — Settings → Delivery partners,
# where credentials are stored encrypted and a Test button proves them without
# shipping anything. These are read only where a partner row has none, and are
# kept for a marketplace that configured Delhivery before that existed.
DELHIVERY_API_TOKEN=
DELHIVERY_BASE_URL=https://track.delhivery.com
DELHIVERY_PICKUP_NAME=
DELHIVERY_SELLER_NAME=
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_LOCATION=
SHIPROCKET_PICKUP_POSTCODE=

# SMS, for the shopper's sign-in code. Set MSG91_AUTHKEY and the driver flips
# to `http` on its own: the code is texted and stops coming back as debug_code.
# SMS_CODE_VARIABLE must match the template's own variable — `##OTP##` is `otp`.
# `php artisan sms:test 9876543210` sends one, on purpose, to a number you name.
MSG91_AUTHKEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER=
SMS_CODE_VARIABLE=otp
# MSG91's OTP endpoint, not /flow: an OTP template posted to flow answers
# `type: success` with a request id and delivers nothing at all.
SMS_URL=https://control.msg91.com/api/v5/otp

# Mail. Nothing in this app is queued, so a send happens inside the request
# that triggered it — the password-reset endpoints and `Notifier` both catch a
# transport failure and log it rather than turning it into a 500.
MAIL_MAILER=smtp
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_EHLO_DOMAIN=
